# ─── Wayfare Backend Environment Variables Template ───────────────────────────

# Server Port
PORT=8081

# JWT Authentication (Bắt buộc >= 32 ký tự ngẫu nhiên trong production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_here
JWT_EXPIRATION=86400000

# Google Gemini AI Integration (Dành riêng cho máy chủ Backend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash

# Cloudinary Storage for Images & Videos
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# MySQL Database Configuration
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=travel_sharing_db
MYSQLUSER=root
MYSQLPASSWORD=your_mysql_password

# CORS Configuration (Tuỳ chọn cho frontend custom domain, phân cách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

